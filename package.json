{
  "name": "arman-personal-website",
  "version": "1.5.0",
  "description": "Arman's Digital Twin — Interactive Virtual Avatar",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:pages": "vite build && node scripts/prerender-routes.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:space": "node scripts/build-hf-space.mjs",
    "twin:url": "node scripts/set-backend-url.mjs",
    "push:space": "node scripts/push-hf-space.mjs",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "voice": "python voice/clone_server.py",
    "voice:chatterbox": "node scripts/pyvoice.mjs voice/chatterbox_server.py",
    "voice:download": "node scripts/pyvoice.mjs voice/download_model.py",
    "voice:progress": "node voice/download-progress.mjs --watch",
    "dev:full": "concurrently \"npm run dev:client\" \"npm run dev:server\" \"npm run voice\"",
    "dev:chatterbox": "concurrently \"npm run dev:client\" \"npm run dev:server\" \"npm run voice:chatterbox\""
  },
  "keywords": [
    "avatar",
    "digital-twin",
    "3d",
    "ai"
  ],
  "author": "Arman Damirchilou",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anam-ai/js-sdk": "^4.18.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.42.0",
    "lenis": "^1.3.25",
    "msedge-tts": "^2.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "undici": "^8.6.0",
    "uuid": "^14.0.1",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4"
  }
}
